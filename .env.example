# API key de Resend (dashboard → API Keys). Necesaria para que /api/contact envíe emails.
RESEND_API_KEY=

# URL final del sitio, sin barra al final. En producción es https://gonzaloquiroga.dev
# (ya cargada como env var en Vercel). Usada para metadata Open Graph, robots.txt
# y sitemap.xml — sin esto cae al dominio propio por defecto.
NEXT_PUBLIC_SITE_URL=

# Remitente de los mails del formulario, formato: Nombre <mail@dominio>
# Opcional: sin esto se usa onboarding@resend.dev, el remitente de prueba de
# Resend, que cae en spam seguido y solo permite enviar al dueño de la cuenta.
# Setearlo una vez que gonzaloquiroga.dev esté verificado en Resend.
CONTACT_FROM=
